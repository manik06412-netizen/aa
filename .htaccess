<IfModule mod_rewrite.c>
RewriteEngine On

# Pass through existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Let admin and avadmin pass through
RewriteRule ^admin(/.*)?$ - [L]
RewriteRule ^avadmin(/.*)?$ - [L]

# Route all application requests to Front Controller index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>